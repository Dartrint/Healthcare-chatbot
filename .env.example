# Use GROQ or LOCAL provider
GROQ_API_KEY=your_groq_api_key_here
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
EMBEDDING_MODEL=all-MiniLM-L6-v2
LOCAL_LLM_PATH=

# Web Search via Tavily (optional — get free API key at https://tavily.com)
TAVILY_API_KEY=tvily-your_api_key_here
TAVILY_MAX_RESULTS=5

# LangSmith tracing (optional — get free API key at https://smith.langchain.com)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx_xxxxxxxxxxxxxxxx
LANGSMITH_PROJECT="healthcare-chatbot"